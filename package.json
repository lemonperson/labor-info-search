{
  "name": "labor-information-search",
  "version": "0.1.0",
  "description": "劳动信息检索桌面应用",
  "author": "Labor Information Search",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "electron-vite build",
    "build:e2e": "electron-vite build --mode e2e",
    "test:e2e": "pnpm build:e2e && playwright test",
    "dist:win": "pnpm build && electron-builder --win nsis --x64",
    "dist:portable": "pnpm build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.11.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
